         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Vanguard Total World Stock Index Fund Annual Report October 31, 2025</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Review this annual report to see how the fund's performance for the recent fiscal year matched your investment goals. This report includes the fund's financial statements, security holdings, and a comparison of the fund's performance to its benchmark.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Vanguard</rdf:li>
            </rdf:Seq>
         </dc:creator>
